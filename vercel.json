{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/pattern-lab/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/zah/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/bjj", "destination": "https://arrowbjjapp.vercel.app/", "permanent": true },
    { "source": "/bjj/", "destination": "https://arrowbjjapp.vercel.app/", "permanent": true },
    { "source": "/bjj/:path*", "destination": "https://arrowbjjapp.vercel.app/:path*", "permanent": true }
  ]
}
